NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mysql://username:password@localhost:3306/buminex_quotation
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
# Production requires distinct random signing secrets (at least 32 bytes each)
# and an HTTPS FRONTEND_URL containing only the browser origin.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

INITIAL_ADMIN_NAME="Buminex Administrator"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Optional software-company account. Set all four values together.
PLATFORM_ADMIN_NAME="Platform Administrator"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=secret_smtp_password
SMTP_FROM_EMAIL=quotations@example.com
SMTP_FROM_NAME="ERP Notifications"

# Opt-in durable worker and outbound webhook transport. Leave empty to disable.
OUTBOX_WORKER_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=1000
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_PREVIOUS_KEYS=
WEBHOOK_ALLOWED_HOSTS=

# Infrastructure timeouts; these are not availability/SLO promises.
HEALTH_PROBE_TIMEOUT_MS=2000
WORKER_STALE_AFTER_MS=300000
SHUTDOWN_TIMEOUT_MS=60000
