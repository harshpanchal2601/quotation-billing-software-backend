  toRecipients        Json                     @map("to_recipients")
  ccRecipients        Json                     @map("cc_recipients")
  bccRecipients       Json                     @map("bcc_recipients")
  subjectSnapshot     String                   @map("subject_snapshot") @db.VarChar(200)
  messageSnapshot     String                   @map("message_snapshot") @db.LongText
  documentSnapshot    Json?                    @map("document_snapshot")
  attachmentSnapshots Json?                    @map("attachment_snapshots")
  providerMessageId   String?                  @map("provider_message_id") @db.VarChar(191)
  failureCategory     String?                  @map("failure_category") @db.VarChar(100)
  failureSummary      String?                  @map("failure_summary") @db.VarChar(500)
  createdAt           DateTime                 @default(now()) @map("created_at")
  acceptedAt          DateTime?                @map("accepted_at")
  failedAt            DateTime?                @map("failed_at")
  quotation           Quotation                @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  generatedDocument   GeneratedDocument?       @relation(fields: [generatedDocumentId], references: [id], onDelete: SetNull)
  sender              User?                    @relation("QuotationCommunicationSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  previousAttempt     QuotationCommunication?  @relation("QuotationCommunicationRetry", fields: [previousAttemptId], references: [id], onDelete: SetNull)
  retryAttempts       QuotationCommunication[] @relation("QuotationCommunicationRetry")

  @@index([quotationId])
  @@index([generatedDocumentId])
  @@index([senderUserId])
  @@index([status])
  @@index([createdAt])
  @@map("quotation_communications")
}

model TermsTemplate {
  id        Int       @id @default(autoincrement())
  firmId    Int       @map("firm_id")
  name      String    @db.VarChar(191)
  termType  TermType  @map("term_type")
  content   String    @db.LongText
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  firm      Firm      @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@index([firmId, termType])
  @@map("terms_templates")
}

model BillOfMaterials {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  code String @db.VarChar(50)
  name String @db.VarChar(191)
  revision Int
  outputItemId Int @map("output_item_id")
  outputQuantity Decimal @map("output_quantity") @db.Decimal(18,3)
  outputUnitId Int @map("output_unit_id")
  outputName String @map("output_name") @db.VarChar(191)
  outputUnit String @map("output_unit") @db.VarChar(50)
  actorId Int @map("actor_id")
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outputItem Item @relation(fields: [outputItemId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict, map: "bills_of_materials_output_owner_fkey")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  components BomComponent[]
  workOrders WorkOrder[]
  @@unique([id, firmId])
  @@unique([firmId, code, revision])
  @@unique([firmId, idempotencyKey])
  @@index([outputItemId, firmId])
  @@map("bills_of_materials")
}

model BomComponent {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  bomId Int @map("bom_id")
  itemId Int @map("item_id")
  quantity Decimal @db.Decimal(18,3)
  unitId Int @map("unit_id")
  name String @db.VarChar(191)
  unit String @db.VarChar(50)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bom BillOfMaterials @relation(fields: [bomId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict, map: "bom_components_bom_owner_fkey")
  item Item @relation(fields: [itemId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict, map: "bom_components_item_owner_fkey")
  @@unique([bomId, itemId])
  @@index([bomId, firmId])
  @@index([itemId, firmId])
  @@map("bom_components")
}

model WorkOrder {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  bomId Int @map("bom_id")
  warehouseId Int @map("warehouse_id")
  quantity Decimal @db.Decimal(18,3)
  currency String @db.VarChar(3)
  status String @default("DRAFT") @db.VarChar(20)
  version Int @default(1)
  snapshot Json
  actorId Int @map("actor_id")
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  completionKey String? @map("completion_key") @db.VarChar(100)
  completionHash String? @map("completion_hash") @db.Char(64)
  cancellationKey String? @map("cancellation_key") @db.VarChar(100)
  cancellationHash String? @map("cancellation_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bom BillOfMaterials @relation(fields: [bomId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict, map: "work_orders_bom_owner_fkey")
  warehouse Warehouse @relation(fields: [warehouseId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict, map: "work_orders_warehouse_owner_fkey")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements StockMovement[]
  @@unique([id, firmId])
  @@unique([firmId, idempotencyKey])
  @@unique([firmId, completionKey])
  @@unique([firmId, cancellationKey])
  @@index([bomId, firmId])
  @@index([warehouseId, firmId])
  @@index([firmId, status, id])
  @@map("work_orders")
}

model SavedReportView {
  id            String   @id @db.VarChar(36)
  firmId        Int      @map("firm_id")
  actorId       Int      @map("actor_id")
