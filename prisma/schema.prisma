}

model PlanVersion {
  id            Int                      @id @default(autoincrement())
  planId        Int                      @map("plan_id")
  revision      Int
  policy        Json?
  price         Decimal?                 @db.Decimal(18, 2)
  currency      String?                  @db.Char(3)
  publishedAt   DateTime?                 @map("published_at")
