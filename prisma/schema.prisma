  @@map("assistant_conversations")
}

// A message is one idempotent request/reply exchange. Content is opt-in;
// minimal request, usage and action evidence survives content erasure.
model AssistantMessage {
  id String @id @db.VarChar(36)
  firmId Int @map("firm_id")
  actorId Int @map("actor_id")
  conversationId String @map("conversation_id") @db.VarChar(36)
  requestId String @map("request_id") @db.VarChar(36)
  requestHash String @map("request_hash") @db.Char(64)
  mode String @db.VarChar(10)
  provider String @db.VarChar(40)
  model String? @db.VarChar(100)
  tool String? @db.VarChar(40)
  status String @default("PENDING") @db.VarChar(20)
  errorCode String? @map("error_code") @db.VarChar(60)
  inputText String? @map("input_text") @db.VarChar(4000)
  response Json?
  contentExpiresAt DateTime? @map("content_expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  conversation AssistantConversation @relation(fields: [conversationId, firmId, actorId], references: [id, firmId, actorId], onDelete: Restrict, onUpdate: Restrict, map: "assistant_message_conversation_fk")
  @@unique([firmId, actorId, requestId], map: "assistant_message_request_key")
  @@index([conversationId, firmId, actorId], map: "assistant_message_conversation_idx")
  @@index([firmId, provider, createdAt], map: "assistant_message_usage_idx")
  @@index([firmId, createdAt], map: "assistant_message_rate_idx")
  @@index([contentExpiresAt], map: "assistant_message_retention_idx")
  @@map("assistant_messages")
}

model AssistantActionProposal {
  id String @id @db.VarChar(36)
