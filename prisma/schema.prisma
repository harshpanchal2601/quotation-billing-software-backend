  createdById             Int           @map("created_by_id")
  updatedById             Int           @map("updated_by_id")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  firm                    Firm          @relation(fields: [firmId], references: [id], onDelete: Restrict)
  company                 Company       @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy               User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User          @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  lines                   InvoiceLine[]
  statusHistory           InvoiceStatusHistory[]
  documents               InvoiceDocument[]
  sourceQuotation         Quotation?    @relation(fields: [sourceQuotationId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  sourceProforma          Invoice?      @relation("ProformaConversion", fields: [sourceProformaId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  convertedInvoices       Invoice[]     @relation("ProformaConversion")
  sourceInvoice           Invoice?      @relation("InvoiceAdjustments", fields: [sourceInvoiceId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  adjustments             Invoice[]     @relation("InvoiceAdjustments")
  paymentAllocations      PaymentAllocation[]
  billingScheduleRun      BillingScheduleRun?
  sourceSalesOrderId      Int? @map("source_sales_order_id")
  sourceSalesOrder        SalesOrder? @relation(fields: [sourceSalesOrderId, firmId, companyId], references: [id, firmId, companyId], onDelete: Restrict, onUpdate: Restrict)
  orderAllocations        SalesOrderInvoiceLine[]
  portalGrants            PortalGrant[]

  @@unique([id, firmId])
  @@unique([id, firmId, companyId, currency], map: "invoices_id_firm_company_currency_key")
  @@unique([id, firmId, companyId])
  @@unique([id, firmId, sourceSalesOrderId])
  @@index([firmId, sourceSalesOrderId, status])
  @@unique([firmId, idempotencyKey])
  @@unique([firmId, documentNumber])
  @@unique([firmId, sourceQuotationId])
  @@unique([firmId, sourceProformaId])
  @@index([sourceInvoiceId, firmId])
  @@index([firmId, invoiceDate, id])
  @@index([firmId, status, createdAt, id])
  @@index([companyId, firmId])
  @@map("invoices")
}

// Tenant customer receipts are intentionally separate from platform PaymentEvent.
model CustomerPayment {
  id             Int       @id @default(autoincrement())
  firmId         Int       @map("firm_id")
  companyId      Int       @map("company_id")
  currency       String    @db.VarChar(3)
  amount         Decimal   @db.Decimal(24, 3)
  method         CustomerPaymentMethod
  reference      String?   @db.VarChar(191)
  receivedDate   DateTime  @map("received_date") @db.Date
  idempotencyKey String    @map("idempotency_key") @db.VarChar(100)
  requestHash    String    @map("request_hash") @db.Char(64)
  createdById    Int       @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  firm           Firm      @relation(fields: [firmId], references: [id], onDelete: Restrict)
  company        Company   @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  reversal       PaymentReversal?
  refunds        CustomerRefund[]

  @@unique([id, firmId])
  @@unique([id, firmId, companyId, currency], map: "customer_payments_id_firm_company_currency_key")
  @@unique([firmId, idempotencyKey])
  @@index([firmId, companyId, currency, id])
  @@index([firmId, receivedDate, id])
  @@map("customer_payments")
}

model PaymentAllocation {
  id          Int       @id @default(autoincrement())
  firmId      Int       @map("firm_id")
  companyId   Int       @map("company_id")
  currency    String    @db.VarChar(3)
  paymentId   Int       @map("payment_id")
  invoiceId   Int       @map("invoice_id")
  amount      Decimal   @db.Decimal(24, 3)
  requestKey  String    @map("request_key") @db.VarChar(100)
  requestHash String    @map("request_hash") @db.Char(64)
  createdById Int       @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  payment     CustomerPayment @relation(fields: [paymentId, firmId, companyId, currency], references: [id, firmId, companyId, currency], onDelete: Restrict, onUpdate: Restrict)
  invoice     Invoice   @relation(fields: [invoiceId, firmId, companyId, currency], references: [id, firmId, companyId, currency], onDelete: Restrict, onUpdate: Restrict)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([paymentId, requestKey, invoiceId])
  @@index([firmId, invoiceId])
  @@index([firmId, paymentId])
  @@index([invoiceId, firmId, companyId, currency], map: "payment_allocations_invoice_owner_idx")
  @@index([paymentId, firmId, companyId, currency], map: "payment_allocations_payment_owner_idx")
  @@map("payment_allocations")
}

model PaymentReversal {
  id             Int       @id @default(autoincrement())
  firmId         Int       @map("firm_id")
  paymentId      Int       @unique @map("payment_id")
  amount         Decimal   @db.Decimal(24, 3)
  reason         String    @db.Text
  idempotencyKey String    @map("idempotency_key") @db.VarChar(100)
  requestHash    String    @map("request_hash") @db.Char(64)
  createdById    Int       @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  payment        CustomerPayment @relation(fields: [paymentId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([firmId, idempotencyKey])
  @@unique([paymentId, firmId])
  @@map("payment_reversals")
}

model CustomerRefund {
  id             Int       @id @default(autoincrement())
  firmId         Int       @map("firm_id")
  paymentId      Int       @map("payment_id")
  amount         Decimal   @db.Decimal(24, 3)
  paidDate       DateTime  @map("paid_date") @db.Date
  reference      String    @db.VarChar(191)
  reason         String    @db.Text
  idempotencyKey String    @map("idempotency_key") @db.VarChar(100)
  requestHash    String    @map("request_hash") @db.Char(64)
  createdById    Int       @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  payment        CustomerPayment @relation(fields: [paymentId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([firmId, idempotencyKey])
  @@index([paymentId, firmId])
  @@index([firmId, paymentId])
  @@map("customer_refunds")
}

model BillingSchedule {
  id             Int       @id @default(autoincrement())
  firmId         Int       @map("firm_id")
  companyId      Int       @map("company_id")
  name           String    @db.VarChar(191)
  status         BillingScheduleStatus @default(PAUSED)
  version        Int       @default(1)
  nextPeriod     DateTime  @map("next_period") @db.Date
  idempotencyKey String    @map("idempotency_key") @db.VarChar(100)
  requestHash    String    @map("request_hash") @db.Char(64)
  createdById    Int       @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  firm           Firm      @relation(fields: [firmId], references: [id], onDelete: Restrict)
  company        Company   @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions       BillingScheduleVersion[]
  runs           BillingScheduleRun[]

  @@unique([id, firmId])
  @@unique([firmId, idempotencyKey])
  @@index([firmId, companyId])
  @@index([status, nextPeriod, id])
