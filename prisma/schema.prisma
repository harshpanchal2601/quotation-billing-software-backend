model Quotation {
  id                      Int                      @id @default(autoincrement())
  firmId                  Int                      @map("firm_id")
  quotationNumber         String                   @map("quotation_number") @db.VarChar(50)
  revisionNumber          Int                      @default(0) @map("revision_number")
  rootQuotationId         Int?                     @map("root_quotation_id")
  previousRevisionId      Int?                     @unique @map("previous_revision_id")
  isLatestRevision        Boolean                  @default(true) @map("is_latest_revision")
  companyId               Int                      @map("company_id")
  companyContactId        Int?                     @map("company_contact_id")
  billingAddressId        Int?                     @map("billing_address_id")
  shippingAddressId       Int?                     @map("shipping_address_id")
  companyNameSnapshot     String                   @map("company_name_snapshot") @db.VarChar(191)
  companyGstinSnapshot    String?                  @map("company_gstin_snapshot") @db.VarChar(20)
  companyPanSnapshot      String?                  @map("company_pan_snapshot") @db.VarChar(20)
  contactNameSnapshot     String?                  @map("contact_name_snapshot") @db.VarChar(191)
  contactEmailSnapshot    String?                  @map("contact_email_snapshot") @db.VarChar(191)
  contactPhoneSnapshot    String?                  @map("contact_phone_snapshot") @db.VarChar(30)
  billingAddressSnapshot  Json?                    @map("billing_address_snapshot")
  shippingAddressSnapshot Json?                    @map("shipping_address_snapshot")
  quotationDate           DateTime                 @map("quotation_date")
  validUntil              DateTime?                @map("valid_until")
  customerReference       String?                  @map("customer_reference") @db.VarChar(191)
  internalReference       String?                  @map("internal_reference") @db.VarChar(191)
  status                  QuotationStatus          @default(DRAFT)
  currency                String                   @default("INR") @db.VarChar(3)
  financialPolicySnapshot Json?                    @map("financial_policy_snapshot")
  automationPresentationSnapshot Json?             @map("automation_presentation_snapshot")
  taxMode                 TaxMode                  @default(CGST_SGST) @map("tax_mode")
  subtotal                Decimal                  @default(0.00) @db.Decimal(15, 2)
  itemDiscountAmount      Decimal                  @default(0.00) @map("item_discount_amount") @db.Decimal(15, 2)
  quotationDiscountType   DiscountType             @default(NONE) @map("quotation_discount_type")
  quotationDiscountValue  Decimal                  @default(0.00) @map("quotation_discount_value") @db.Decimal(15, 2)
  quotationDiscountAmount Decimal                  @default(0.00) @map("quotation_discount_amount") @db.Decimal(15, 2)
  taxableAmount           Decimal                  @default(0.00) @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount              Decimal                  @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount              Decimal                  @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount              Decimal                  @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  freightAmount           Decimal                  @default(0.00) @map("freight_amount") @db.Decimal(15, 2)
  freightIncluded         Boolean                  @default(false) @map("freight_included")
  freightIsTaxable        Boolean                  @default(false) @map("freight_is_taxable")
  otherCharges            Decimal                  @default(0.00) @map("other_charges") @db.Decimal(15, 2)
  roundOffAmount          Decimal                  @default(0.00) @map("round_off_amount") @db.Decimal(15, 2)
  grandTotal              Decimal                  @default(0.00) @map("grand_total") @db.Decimal(15, 2)
  amountInWords           String?                  @map("amount_in_words") @db.Text
  deliveryTerms           String?                  @map("delivery_terms") @db.Text
  dispatchTerms           String?                  @map("dispatch_terms") @db.Text
  paymentTerms            String?                  @map("payment_terms") @db.Text
  taxTerms                String?                  @map("tax_terms") @db.Text
  freightTerms            String?                  @map("freight_terms") @db.Text
  warrantyTerms           String?                  @map("warranty_terms") @db.Text
  remarks                 String?                  @db.Text
  termsAndConditions      String?                  @map("terms_and_conditions") @db.LongText
  internalNotes           String?                  @map("internal_notes") @db.LongText
  createdById             Int                      @map("created_by_id")
  updatedById             Int?                     @map("updated_by_id")
  sentAt                  DateTime?                @map("sent_at")
  acceptedAt              DateTime?                @map("accepted_at")
  rejectedAt              DateTime?                @map("rejected_at")
  completedAt             DateTime?                @map("completed_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyContact          CompanyContact?          @relation(fields: [companyContactId], references: [id], onDelete: SetNull)
  billingAddress          CompanyAddress?          @relation("QuotationBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingAddress         CompanyAddress?          @relation("QuotationShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  createdBy               User                     @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User?                    @relation("QuotationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  firm                    Firm                     @relation(fields: [firmId], references: [id], onDelete: Restrict)
  rootQuotation           Quotation?               @relation("QuotationRoot", fields: [rootQuotationId], references: [id], onDelete: Restrict)
  revisionFamily          Quotation[]              @relation("QuotationRoot")
  previousRevision        Quotation?               @relation("QuotationPrevious", fields: [previousRevisionId], references: [id], onDelete: Restrict)
  nextRevision            Quotation?               @relation("QuotationPrevious")
  items                   QuotationItem[]
  statusHistory           QuotationStatusHistory[]
  versions                QuotationVersion[]
  attachments             QuotationAttachment[]
  generatedDocuments      GeneratedDocument[]
  communications          QuotationCommunication[]
  invoices                Invoice[]
  salesOrders             SalesOrder[]
  opportunities           Opportunity[]
  portalGrants            PortalGrant[]
  acceptances             DocumentAcceptance[]

  @@unique([firmId, quotationNumber, revisionNumber])
  @@unique([id, firmId])
  @@unique([firmId, rootQuotationId, revisionNumber])
  @@unique([id, firmId, companyId])
  @@index([firmId, quotationDate])
  @@index([status])
  @@index([companyId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([rootQuotationId])
  @@index([isLatestRevision])
  @@map("quotations")
}

model QuotationItem {
