  schedule    BillingSchedule @relation(fields: [scheduleId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  revision    BillingScheduleVersion @relation(fields: [scheduleId, firmId, version], references: [scheduleId, firmId, version], onDelete: Restrict, onUpdate: Restrict)
  invoice     Invoice?  @relation(fields: [invoiceId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scheduleId, period])
  @@index([firmId, createdAt, id])
  @@index([scheduleId, firmId, version])
  @@unique([invoiceId, firmId])
  @@map("billing_schedule_runs")
}

model InvoiceSetting {
