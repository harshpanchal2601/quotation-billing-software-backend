generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

// Transitional account classification for the multi-firm rollout. The legacy
// UserRole field remains until all application authorization has moved to the
// account type and permission model.
enum AccountType {
  SUPER_ADMIN
  FIRM_ADMIN
  FIRM_USER
}

enum FirmStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum CustomerPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  EXTERNAL_CONFIRMED
}

enum BillingScheduleStatus {
  PAUSED
  ACTIVE
  CANCELLED
  COMPLETED
}

enum BillingScheduleRunStatus {
  QUEUED
  DRAFT_CREATED
  CANCELLED
}

enum AddressType {
  BILLING
  SHIPPING
  OTHER
}

enum ItemSourceType {
  MANUAL
  WEBSITE_IMPORT
  CSV_IMPORT
}

enum ItemKind {
  GOODS
  SERVICE
}

enum QuotationStatus {
  DRAFT
  PENDING
  SENT
  ACCEPTED
  REJECTED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum TaxMode {
  CGST_SGST
  IGST
  NONE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum BillingDocumentKind {
  INVOICE
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}

enum SequenceResetRule {
  FINANCIAL_YEAR
  CALENDAR_YEAR
  NEVER
}

enum TermType {
  DELIVERY
  DISPATCH
  PAYMENT
  TAX
  FREIGHT
  WARRANTY
  REMARKS
  GENERAL
}

enum DocumentType {
  QUOTATION_PDF
}

enum CommunicationType {
  QUOTATION_EMAIL
}

enum CommunicationStatus {
  PENDING
  ACCEPTED
  FAILED
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum ImportRowStatus {
  PENDING
  APPROVED
  REJECTED
  IMPORTED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  STATUS_CHANGE
  GENERATE_PDF
  IMPORT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  DEAD
  RECONCILE
}

model DocumentSequence {
  id           Int      @id @default(autoincrement())
  firmId       Int      @map("firm_id")
  documentType String   @map("document_type") @db.VarChar(32)
  period       String   @db.VarChar(32)
  nextValue    BigInt   @default(1) @map("next_value")
  updatedAt    DateTime @updatedAt @map("updated_at")
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@unique([firmId, documentType, period])
  @@map("document_sequences")
}

model FirmBusinessPolicy {
  id        Int      @id @default(autoincrement())
  firmId    Int      @map("firm_id")
  version   Int
  policy    Json
  actorId   Int      @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@unique([firmId, version])
  @@map("firm_business_policies")
}

model OutboxEvent {
  id             String       @id @db.VarChar(36)
  firmId         Int          @map("firm_id")
  actorId        Int          @map("actor_id")
  kind           String       @db.VarChar(100)
  sourceEventId  String       @map("source_event_id") @db.VarChar(191)
  correlationId  String?      @map("correlation_id") @db.VarChar(191)
  idempotencyKey String       @map("idempotency_key") @db.VarChar(191)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5) @map("max_attempts")
  availableAt    DateTime     @default(now()) @map("available_at")
  lockedUntil    DateTime?    @map("locked_until")
  lockToken      String?      @map("lock_token") @db.VarChar(36)
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  firm           Firm         @relation(fields: [firmId], references: [id], onDelete: Restrict)
  jobAttempts    JobAttempt[]
  notifications NotificationDelivery[]
  workflowRun WorkflowRun?

  @@unique([firmId, idempotencyKey])
  @@unique([id, firmId])
  @@index([status, availableAt])
  @@index([status, lockedUntil])
  @@index([firmId, correlationId], map: "outbox_firm_correlation_idx")
  @@map("outbox_events")
}

model JobAttempt {
  id           Int         @id @default(autoincrement())
  eventId      String      @map("event_id") @db.VarChar(36)
  attempt      Int
  workerId     String      @map("worker_id") @db.VarChar(100)
  startedAt    DateTime    @default(now()) @map("started_at")
  finishedAt   DateTime?   @map("finished_at")
  outcome      String?     @db.VarChar(32)
  errorCode    String?     @map("error_code") @db.VarChar(100)
  event        OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, attempt])
  @@map("job_attempts")
}

model NotificationPreference {
  id        Int     @id @default(autoincrement())
  firmId    Int     @map("firm_id")
  channel   String  @db.VarChar(20)
  enabled   Boolean @default(true)
  firm      Firm    @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@unique([firmId, channel])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id          Int         @id @default(autoincrement())
  firmId      Int         @map("firm_id")
  eventId     String      @map("event_id") @db.VarChar(36)
  recipientId Int         @map("recipient_id")
  title       String      @db.VarChar(191)
  body        String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  firm        Firm        @relation(fields: [firmId], references: [id], onDelete: Restrict)
  event       OutboxEvent @relation(fields: [eventId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventId, recipientId])
  @@index([firmId, recipientId, createdAt])
  @@map("notification_deliveries")
}

// Wave 06 uses the existing Company and Item masters. No customer copy exists.
model Lead {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  name String @db.VarChar(191)
  email String? @db.VarChar(191)
  phone String? @db.VarChar(30)
  source String? @db.VarChar(191)
  status String @default("NEW") @db.VarChar(20)
  companyId Int? @map("company_id")
  ownerId Int @map("owner_id")
  createdById Int @map("created_by_id")
  version Int @default(1)
  conversionKey String? @map("conversion_key") @db.VarChar(100)
  conversionHash String? @map("conversion_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company Company? @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  owner User @relation("LeadOwner", fields: [ownerId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  opportunities Opportunity[]
  tasks SalesTask[]
  activities SalesActivity[]
  @@unique([id, firmId])
  @@unique([firmId, conversionKey])
  @@index([firmId, ownerId, id])
  @@index([companyId, firmId])
  @@map("leads")
}

model Opportunity {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  title String @db.VarChar(191)
  stage String @db.VarChar(30)
  probability Int
  value Decimal @db.Decimal(24,3)
  currency String @db.VarChar(3)
  ownerId Int @map("owner_id")
  createdById Int @map("created_by_id")
  expectedClose DateTime? @map("expected_close") @db.Date
  companyId Int? @map("company_id")
  leadId Int? @map("lead_id")
  quotationId Int? @map("quotation_id")
  source String? @db.VarChar(191)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company Company? @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  lead Lead? @relation(fields: [leadId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  quotation Quotation? @relation(fields: [quotationId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  owner User @relation("OpportunityOwner", fields: [ownerId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks SalesTask[]
  activities SalesActivity[]
  @@unique([id, firmId])
  @@index([firmId, stage, id])
  @@index([firmId, ownerId, id])
  @@index([firmId, createdAt, id], map: "opportunities_reporting_period_idx")
  @@index([firmId, ownerId, createdAt, id], map: "opportunities_reporting_owner_idx")
  @@index([firmId, createdById, createdAt, id], map: "opportunities_reporting_creator_idx")
  @@index([companyId, firmId])
  @@map("opportunities")
}

model SalesTask {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  title String @db.VarChar(191)
  notes String? @db.Text
  status String @default("OPEN") @db.VarChar(20)
  assignedToId Int @map("assigned_to_id")
  createdById Int @map("created_by_id")
  dueAt DateTime @map("due_at")
  reminderAt DateTime? @map("reminder_at")
  companyId Int? @map("company_id")
  leadId Int? @map("lead_id")
  opportunityId Int? @map("opportunity_id")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company Company? @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  lead Lead? @relation(fields: [leadId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  opportunity Opportunity? @relation(fields: [opportunityId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  assignee User @relation("TaskAssignee", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activities SalesActivity[]
  @@unique([id, firmId])
  @@index([firmId, assignedToId, status, dueAt])
  @@index([companyId, firmId])
  @@map("sales_tasks")
}

model SalesActivity {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  companyId Int? @map("company_id")
  leadId Int? @map("lead_id")
  opportunityId Int? @map("opportunity_id")
  taskId Int? @map("task_id")
  kind String @db.VarChar(30)
  subject String @db.VarChar(191)
  notes String? @db.Text
  details Json?
  createdById Int @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company Company? @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  lead Lead? @relation(fields: [leadId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  opportunity Opportunity? @relation(fields: [opportunityId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  task SalesTask? @relation(fields: [taskId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([firmId, companyId, id])
  @@index([leadId, firmId])
  @@map("sales_activities")
}

model SalesOrder {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  companyId Int @map("company_id")
  sourceQuotationId Int @map("source_quotation_id")
  orderNumber String @map("order_number") @db.VarChar(50)
  status String @default("OPEN") @db.VarChar(30)
  version Int @default(1)
  currency String @db.VarChar(3)
  snapshot Json
  snapshotHash String @map("snapshot_hash") @db.Char(64)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  createdById Int @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company Company @relation(fields: [companyId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  sourceQuotation Quotation @relation(fields: [sourceQuotationId, firmId, companyId], references: [id, firmId, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines SalesOrderLine[]
  fulfillments Fulfillment[]
  history SalesOrderHistory[]
  invoices Invoice[]
  portalGrants PortalGrant[]
  @@unique([id, firmId])
  @@unique([id, firmId, companyId])
  @@unique([firmId, sourceQuotationId])
  @@unique([firmId, idempotencyKey])
  @@unique([firmId, orderNumber])
  @@index([firmId, status, id])
  @@index([companyId, firmId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  salesOrderId Int @map("sales_order_id")
  lineNumber Int @map("line_number")
  quantity Decimal @db.Decimal(18,3)
  snapshot Json
  order SalesOrder @relation(fields: [salesOrderId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  fulfillmentLines FulfillmentLine[]
  invoiceLines SalesOrderInvoiceLine[]
  stockReservations StockReservation[]
  @@unique([id, firmId, salesOrderId])
  @@unique([salesOrderId, lineNumber])
  @@map("sales_order_lines")
}

// Inventory quantities are projections of immutable postings. Every writer uses
// the existing firm transaction lock, including sales fulfillment commands.
model Warehouse {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  code String @db.VarChar(50)
  name String @db.VarChar(191)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  positions StockPosition[]
  receipts GoodsReceipt[]
  workOrders WorkOrder[]
  @@unique([id, firmId])
  @@unique([firmId, code])
  @@map("warehouses")
}

model StockPosition {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  warehouseId Int @map("warehouse_id")
  itemId Int @map("item_id")
  currency String @db.VarChar(3)
  onHand Decimal @default(0) @map("on_hand") @db.Decimal(18,3)
  reserved Decimal @default(0) @db.Decimal(18,3)
  value Decimal @default(0) @db.Decimal(30,6)
  reorderLevel Decimal @default(0) @map("reorder_level") @db.Decimal(18,3)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  item Item @relation(fields: [itemId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  movements StockMovement[]
  reservations StockReservation[]
  @@unique([id, firmId])
  @@unique([firmId, warehouseId, itemId])
  @@index([itemId, firmId])
  @@index([warehouseId, firmId])
  @@map("stock_positions")
}

model StockMovement {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  positionId Int @map("position_id")
  sourceType String @map("source_type") @db.VarChar(30)
  sourceId Int @map("source_id")
  sourceLineId Int @map("source_line_id")
  eventType String @map("event_type") @db.VarChar(30)
  quantity Decimal @db.Decimal(18,3)
  value Decimal @db.Decimal(30,6)
  originalMovementId Int? @map("original_movement_id")
  workOrderId Int? @map("work_order_id")
  reason String @db.VarChar(2000)
  actorId Int @map("actor_id")
  postedAt DateTime @default(now()) @map("posted_at")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  position StockPosition @relation(fields: [positionId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  original StockMovement? @relation("StockCorrection", fields: [originalMovementId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  corrections StockMovement[] @relation("StockCorrection")
  workOrder WorkOrder? @relation(fields: [workOrderId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict, map: "stock_movements_work_order_owner_fkey")
  @@unique([id, firmId])
  @@unique([firmId, sourceType, sourceId, sourceLineId, eventType], map: "stock_movement_source_event_key")
  @@index([positionId, firmId, postedAt, id], map: "stock_movement_position_period_idx")
  @@index([firmId, postedAt, positionId], map: "stock_movement_reporting_period_idx")
  @@index([originalMovementId, firmId])
  @@index([workOrderId, firmId])
  @@map("stock_movements")
}

model StockReservation {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  positionId Int @map("position_id")
  salesOrderId Int @map("sales_order_id")
  salesOrderLineId Int @map("sales_order_line_id")
  quantity Decimal @db.Decimal(18,3)
  remaining Decimal @db.Decimal(18,3)
  status String @default("ACTIVE") @db.VarChar(20)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  actorId Int @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")
  releaseReason String? @map("release_reason") @db.VarChar(2000)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  position StockPosition @relation(fields: [positionId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  orderLine SalesOrderLine @relation(fields: [salesOrderLineId, firmId, salesOrderId], references: [id, firmId, salesOrderId], onDelete: Restrict, onUpdate: Restrict, map: "stock_reservation_order_line_fkey")
  @@unique([firmId, idempotencyKey])
  @@index([positionId, firmId, status])
  @@index([firmId, salesOrderId, salesOrderLineId, status], map: "stock_reservation_order_idx")
  @@map("stock_reservations")
}

model StockOperation {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  kind String @db.VarChar(30)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  payload Json
  actorId Int @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  @@unique([firmId, idempotencyKey])
  @@index([firmId, kind, id])
  @@map("stock_operations")
}

model PurchaseOrder {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  supplierId Int @map("supplier_id")
  orderNumber String @map("order_number") @db.VarChar(50)
  status String @default("DRAFT") @db.VarChar(30)
  version Int @default(1)
  expectedDate DateTime? @map("expected_date") @db.Date
  currency String @db.VarChar(3)
  supplierSnapshot Json @map("supplier_snapshot")
  financialSnapshot Json @map("financial_snapshot")
  total Decimal @db.Decimal(24,3)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  actorId Int @map("actor_id")
  cancellationReason String? @map("cancellation_reason") @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  supplier Company @relation(fields: [supplierId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  lines PurchaseOrderLine[]
  receipts GoodsReceipt[]
  @@unique([id, firmId])
  @@unique([firmId, orderNumber])
  @@unique([firmId, idempotencyKey])
  @@index([supplierId, firmId])
  @@index([firmId, status, id])
  @@index([firmId, createdAt, id], map: "purchase_order_reporting_period_idx")
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  purchaseOrderId Int @map("purchase_order_id")
  itemId Int @map("item_id")
  lineNumber Int @map("line_number")
  quantity Decimal @db.Decimal(18,3)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18,3)
  unitCost Decimal @map("unit_cost") @db.Decimal(24,3)
  snapshot Json
  order PurchaseOrder @relation(fields: [purchaseOrderId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  item Item @relation(fields: [itemId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  receiptLines GoodsReceiptLine[]
  billLines SupplierBillLine[]
  @@unique([id, firmId])
  @@unique([purchaseOrderId, lineNumber])
  @@index([itemId, firmId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  purchaseOrderId Int @map("purchase_order_id")
  warehouseId Int? @map("warehouse_id")
  reference String @db.VarChar(191)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  actorId Int @map("actor_id")
  cancelledAt DateTime? @map("cancelled_at")
  cancellationReason String? @map("cancellation_reason") @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  order PurchaseOrder @relation(fields: [purchaseOrderId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  warehouse Warehouse? @relation(fields: [warehouseId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  lines GoodsReceiptLine[]
  @@unique([id, firmId])
  @@unique([firmId, idempotencyKey])
  @@index([purchaseOrderId, firmId])
  @@index([warehouseId, firmId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id Int @id @default(autoincrement())
  firmId Int @map("firm_id")
  goodsReceiptId Int @map("goods_receipt_id")
  purchaseOrderLineId Int @map("purchase_order_line_id")
  quantity Decimal @db.Decimal(18,3)
