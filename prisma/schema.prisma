  updatedAt DateTime @updatedAt @map("updated_at")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@id([firmId, resource])
  @@map("firm_usage_counters")
}

// Scalar tenant/actor snapshots intentionally survive fixture/identity deletion.
// These ledgers are append-only; firm-facing reads always filter firmId.
model UsageEvent {
  id        Int      @id @default(autoincrement())
  firmId    Int      @map("firm_id")
  resource  String   @db.VarChar(30)
  eventId   String   @map("event_id") @db.VarChar(191)
  delta     BigInt
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([firmId, resource, eventId])
  @@index([firmId, createdAt])
  @@map("firm_usage_events")
}

model SubscriptionEvent {
  id        Int      @id @default(autoincrement())
  firmId    Int?     @map("firm_id")
  authorId  Int      @map("author_id")
  kind      String   @db.VarChar(100)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([firmId, createdAt])
  @@index([kind, createdAt])
  @@map("platform_subscription_events")
}

model PlatformCharge {
  id             Int            @id @default(autoincrement())
  firmId         Int            @map("firm_id")
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(191)
  amount         Decimal        @db.Decimal(18, 2)
  currency       String         @db.Char(3)
  reason         String         @db.VarChar(500)
  authorId       Int            @map("author_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  firm           Firm           @relation(fields: [firmId], references: [id], onDelete: Restrict)
  payments       PaymentEvent[]

  @@index([firmId, createdAt])
  @@map("platform_charges")
}

model PaymentEvent {
  id             Int            @id @default(autoincrement())
  chargeId       Int            @map("charge_id")
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(191)
  kind           String         @db.VarChar(20)
  amount         Decimal        @db.Decimal(18, 2)
  reference      String         @db.VarChar(191)
  reason         String         @db.VarChar(500)
  authorId       Int            @map("author_id")
  createdAt      DateTime       @default(now()) @map("created_at")
