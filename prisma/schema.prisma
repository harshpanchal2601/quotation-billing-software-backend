  filters       Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  firm          Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, firmId])
  @@unique([firmId, actorId, name])
  @@index([firmId, actorId, updatedAt, id])
  @@map("saved_report_views")
}

model ImportBatch {
  id                Int               @id @default(autoincrement())
  firmId            Int               @map("firm_id")
  sourceType        ItemSourceType    @map("source_type")
  sourceUrl         String?           @map("source_url") @db.VarChar(500)
  status            ImportBatchStatus @default(PENDING)
  totalRecords      Int               @default(0) @map("total_records")
  successfulRecords Int               @default(0) @map("successful_records")
  failedRecords     Int               @default(0) @map("failed_records")
  startedById       Int               @map("started_by_id")
  startedAt         DateTime          @default(now()) @map("started_at")
  completedAt       DateTime?         @map("completed_at")
  errorSummary      String?           @map("error_summary") @db.Text
  startedBy         User              @relation("ImportBatchStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  firm              Firm              @relation(fields: [firmId], references: [id], onDelete: Restrict)
  rows              ImportRow[]

  @@index([firmId, status])
  @@map("import_batches")
}

model ImportRow {
  id               Int             @id @default(autoincrement())
  importBatchId    Int             @map("import_batch_id")
  sourceIdentifier String?         @map("source_identifier") @db.VarChar(191)
  rawData          Json            @map("raw_data")
  processedData    Json?           @map("processed_data")
  status           ImportRowStatus @default(PENDING)
  errorMessage     String?         @map("error_message") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  importBatch      ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@index([status])
  @@map("import_rows")
}

model AuditLog {
  id         Int         @id @default(autoincrement())
