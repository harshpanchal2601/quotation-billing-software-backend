model BillingScheduleVersion {
  id          Int       @id @default(autoincrement())
  firmId      Int       @map("firm_id")
  scheduleId  Int       @map("schedule_id")
  version     Int
  config      Json
  preview     Json
  approvedAt  DateTime? @map("approved_at")
  approvedById Int?     @map("approved_by_id")
  createdById Int       @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  schedule    BillingSchedule @relation(fields: [scheduleId, firmId], references: [id, firmId], onDelete: Restrict, onUpdate: Restrict)
  createdBy   User      @relation("BillingScheduleVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?     @relation("BillingScheduleVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  runs        BillingScheduleRun[]

